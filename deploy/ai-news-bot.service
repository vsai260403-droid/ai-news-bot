[Unit]
Description=AI News Discord Bot (Always-On Q&A)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ai-news-bot
ExecStart=/opt/ai-news-bot/venv/bin/python discord_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-news-bot

# 환경변수 파일 (.env)
EnvironmentFile=/opt/ai-news-bot/.env

[Install]
WantedBy=multi-user.target
